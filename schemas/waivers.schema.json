{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vildande/evidence-gate/schemas/waivers.schema.json",
  "title": "Waivers",
  "description": "Approved, time-limited waivers: let PRs pass one rule until a date",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["rule", "reason", "approved_by", "expires"],
    "properties": {
      "rule": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
      "reason": { "type": "string", "minLength": 1 },
      "approved_by": { "type": "string", "minLength": 1 },
      "expires": { "type": "string", "format": "date" }
    }
  }
}
